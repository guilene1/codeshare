# Copy to .env before deploying. Domain must resolve to your server.
DOMAIN=code.example.com
# www host (always redirects to DOMAIN) and the previous domain.
WWW_DOMAIN=www.code.example.com
LEGACY_DOMAIN=old.example.com
# app = previous domain keeps serving; legacy_redirect = it redirects to DOMAIN (default).
LEGACY_MODE=legacy_redirect
ACME_EMAIL=you@example.com
# Local backend only (Compose sets its own production origin and database path)
PORT=3000
DB_PATH=data/devshare.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
TRUST_PROXY=0
# Optional protected operational metrics. Generate a random secret for production.
METRICS_TOKEN=
# Optional backups: export these in the host environment when running backup.sh.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=devshare
AWS_REGION=us-east-1
# Prefer IAM roles or aws configure; never commit credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
